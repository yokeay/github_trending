# GitHub Personal Access Token (optional but recommended)
# Without token: 10 req/min; With token: 30 req/min
# Create at: https://github.com/settings/tokens (no scopes needed)
GITHUB_TOKEN=ghp_your_token_here

# Server port (default: 3000)
PORT=3000

# Build mode (development / staging / production)
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────
# SQLite database file path
DATABASE_URL=./data/gth.db

# ─── Cache ──────────────────────────────────────────────────
# Cache provider: memory | redis
CACHE_PROVIDER=memory
# Cache TTL in milliseconds (default: 5 minutes)
CACHE_TTL=300000

# ─── Security ───────────────────────────────────────────────
# Secret key for encrypting sensitive data (e.g., TOTP keys)
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=

# ─── Backup & Disaster Recovery ──────────────────────────────
# Enable disaster backup: true | false
DISASTER_BACKUP_ENABLED=false
# Backup interval in hours (e.g., 24 = daily backup)
DISASTER_BACKUP_INTERVAL=24
# Backup retention in days (old backups older than this are deleted)
DISASTER_BACKUP_RETENTION=7
# Backup storage path (absolute or relative to project root)
DISASTER_BACKUP_PATH=./backups

# ─── Logging ────────────────────────────────────────────────
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Enable audit logging: true | false
AUDIT_LOG_ENABLED=true
